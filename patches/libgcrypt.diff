diff --git a/CMakeLists.txt b/CMakeLists.txt
new file mode 100644
index 0000000..322f3e1
--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,274 @@
+cmake_minimum_required(VERSION 3.15)
+
+project(libgcrypt VERSION 1.12.4 LANGUAGES C)
+
+# cipher/gost-sb.h is normally made at build time by running gost-s-box;
+# it is committed so cross builds (ARM64, UWP) need no host-run tool.
+# Turn this on after a version bump to regenerate it (x64 host build).
+option(GENERATE_FILES "Regenerate the committed cipher/gost-sb.h" OFF)
+
+find_package(libgpg-error 1.61 NO_MODULE REQUIRED)
+
+if(MSVC)
+  set(CMAKE_DEBUG_POSTFIX "d")
+endif()
+
+set(GEN_DIR ${CMAKE_CURRENT_BINARY_DIR}/generated)
+
+# src/gcrypt.h from gcrypt.h.in (what configure does).
+set(VERSION ${PROJECT_VERSION})
+math(EXPR VERSION_NUMBER
+  "(${PROJECT_VERSION_MAJOR} << 16) | (${PROJECT_VERSION_MINOR} << 8) | ${PROJECT_VERSION_PATCH}"
+  OUTPUT_FORMAT HEXADECIMAL)
+string(REGEX REPLACE "^0x" "" VERSION_NUMBER "${VERSION_NUMBER}")
+string(LENGTH "${VERSION_NUMBER}" len)
+while(len LESS 6)
+  set(VERSION_NUMBER "0${VERSION_NUMBER}")
+  string(LENGTH "${VERSION_NUMBER}" len)
+endwhile()
+set(VERSION_NUMBER "0x${VERSION_NUMBER}")
+set(configure_input "Generated from gcrypt.h.in by CMake.")
+set(emacs_local_vars_begin "Local Variables:")
+set(emacs_local_vars_read_only "buffer-read-only: t")
+set(emacs_local_vars_end "End:")
+configure_file(src/gcrypt.h.in ${GEN_DIR}/gcrypt.h @ONLY)
+
+# mpi: the generic C implementation (what mpi/config.links picks when
+# there is no assembler).
+# src/mpi.h includes it as ../mpi/mpi-asm-defs.h, so it goes into mpi/.
+configure_file(mpi/generic/mpi-asm-defs.h ${CMAKE_CURRENT_SOURCE_DIR}/mpi/mpi-asm-defs.h COPYONLY)
+set(MPI_GENERIC_MODULES add1 sub1 mul1 mul2 mul3 lshift rshift)
+set(mod_source_info "/* Created by CMake - do not edit */\n/* Host: generic */\nstatic char mod_source_info[] =\n")
+set(MPI_GENERIC_SOURCES)
+foreach(m ${MPI_GENERIC_MODULES})
+  string(APPEND mod_source_info "  \":generic/mpih-${m}.c\"\n")
+  list(APPEND MPI_GENERIC_SOURCES mpi/generic/mpih-${m}.c)
+endforeach()
+string(APPEND mod_source_info "  ;\n")
+file(CONFIGURE OUTPUT ${GEN_DIR}/mod-source-info.h CONTENT "${mod_source_info}")
+
+add_library(libgcrypt STATIC
+  # cipher: framework
+  cipher/cipher.c
+  cipher/cipher-aeswrap.c
+  cipher/cipher-cbc.c
+  cipher/cipher-ccm.c
+  cipher/cipher-cfb.c
+  cipher/cipher-cmac.c
+  cipher/cipher-ctr.c
+  cipher/cipher-eax.c
+  cipher/cipher-gcm.c
+  cipher/cipher-gcm-siv.c
+  cipher/cipher-ocb.c
+  cipher/cipher-ofb.c
+  cipher/cipher-poly1305.c
+  cipher/cipher-siv.c
+  cipher/cipher-xts.c
+  cipher/dsa-common.c
+  cipher/hash-common.c
+  cipher/kdf.c
+  cipher/kem.c
+  cipher/kem-ecc.c
+  cipher/mac.c
+  cipher/mac-cmac.c
+  cipher/mac-gmac.c
+  cipher/mac-hmac.c
+  cipher/mac-poly1305.c
+  cipher/mceliece6688128f.c
+  cipher/md.c
+  cipher/poly1305.c
+  cipher/primegen.c
+  cipher/pubkey.c
+  cipher/pubkey-util.c
+  cipher/rsa-common.c
+  cipher/sntrup761.c
+  # cipher: symmetric ciphers
+  cipher/arcfour.c
+  cipher/aria.c
+  cipher/blowfish.c
+  cipher/camellia.c
+  cipher/camellia-glue.c
+  cipher/cast5.c
+  cipher/chacha20.c
+  cipher/des.c
+  cipher/gost28147.c
+  cipher/idea.c
+  cipher/rfc2268.c
+  cipher/rijndael.c
+  cipher/salsa20.c
+  cipher/seed.c
+  cipher/serpent.c
+  cipher/sm4.c
+  cipher/twofish.c
+  # cipher: public key
+  cipher/dilithium.c
+  cipher/dsa.c
+  cipher/ecc.c
+  cipher/ecc-curves.c
+  cipher/ecc-ecdh.c
+  cipher/ecc-ecdsa.c
+  cipher/ecc-eddsa.c
+  cipher/ecc-gost.c
+  cipher/ecc-misc.c
+  cipher/ecc-sm2.c
+  cipher/elgamal.c
+  cipher/kyber.c
+  cipher/pubkey-dilithium.c
+  cipher/rsa.c
+  # cipher: digests and KDFs
+  cipher/blake2.c
+  cipher/crc.c
+  cipher/gostr3411-94.c
+  cipher/keccak.c
+  cipher/md4.c
+  cipher/md5.c
+  cipher/rmd160.c
+  cipher/scrypt.c
+  cipher/sha1.c
+  cipher/sha256.c
+  cipher/sha512.c
+  cipher/sm3.c
+  cipher/stribog.c
+  cipher/tiger.c
+  cipher/whirlpool.c
+  # compat
+  compat/compat.c
+  # mpi
+  ${MPI_GENERIC_SOURCES}
+  mpi/ec.c
+  mpi/ec-ed25519.c
+  mpi/ec-hw-s390x.c
+  mpi/ec-nist.c
+  mpi/mpi-add.c
+  mpi/mpi-bit.c
+  mpi/mpi-cmp.c
+  mpi/mpi-div.c
+  mpi/mpi-gcd.c
+  mpi/mpi-inline.c
+  mpi/mpi-inv.c
+  mpi/mpi-mod.c
+  mpi/mpi-mpow.c
+  mpi/mpi-mul.c
+  mpi/mpi-pow.c
+  mpi/mpi-scan.c
+  mpi/mpicoder.c
+  mpi/mpih-const-time.c
+  mpi/mpih-div.c
+  mpi/mpih-mul.c
+  mpi/mpih-pow.c
+  mpi/mpiutil.c
+  # random
+  random/random.c
+  random/random-csprng.c
+  random/random-drbg.c
+  random/random-system.c
+  random/rndhw.c
+  random/rndjent.c
+  random/rndw32.c
+  # src
+  src/const-time.c
+  src/context.c
+  src/fips.c
+  src/global.c
+  src/hwfeatures.c
+  src/misc.c
+  src/missing-string.c
+  src/secmem.c
+  src/sexp.c
+  src/stdmem.c
+  src/visibility.c
+)
+
+if(WINDOWS_STORE)
+  # UWP apps lack some desktop APIs; the sources have MS_APP fallbacks.
+  target_compile_definitions(libgcrypt PRIVATE MS_APP)
+  # MSBuild enables SDL checks for UWP projects; they turn intended
+  # constructs of the crypto code (e.g. negating unsigned values, C4146)
+  # into errors.  Desktop builds do not use SDL checks either.
+  target_compile_options(libgcrypt PRIVATE
+    /sdl-
+    /FI${CMAKE_CURRENT_SOURCE_DIR}/cmake/msvc/uwp-compat.h)
+  target_link_libraries(libgcrypt PUBLIC bcrypt)
+endif()
+
+target_compile_definitions(libgcrypt
+  PRIVATE
+    HAVE_CONFIG_H
+    _CRT_SECURE_NO_WARNINGS
+    _CRT_NONSTDC_NO_WARNINGS
+)
+
+target_include_directories(libgcrypt
+  PRIVATE
+    ${CMAKE_CURRENT_SOURCE_DIR}/cmake
+    ${CMAKE_CURRENT_SOURCE_DIR}/cmake/msvc
+    ${GEN_DIR}
+    ${CMAKE_CURRENT_SOURCE_DIR}/src
+    ${CMAKE_CURRENT_SOURCE_DIR}/mpi
+    ${CMAKE_CURRENT_SOURCE_DIR}/cipher
+    ${CMAKE_CURRENT_SOURCE_DIR}/compat
+    ${CMAKE_CURRENT_SOURCE_DIR}/random
+  INTERFACE
+    $<INSTALL_INTERFACE:include/libgcrypt>
+)
+
+target_link_libraries(libgcrypt PUBLIC libgpg-error::libgpg-error)
+
+if(GENERATE_FILES)
+  add_executable(gost-s-box cipher/gost-s-box.c)
+  target_compile_definitions(gost-s-box PRIVATE _CRT_SECURE_NO_WARNINGS)
+  add_custom_target(generate-files
+    COMMAND gost-s-box ${CMAKE_CURRENT_SOURCE_DIR}/cipher/gost-sb.h
+    DEPENDS gost-s-box
+    COMMENT "Generating cipher/gost-sb.h"
+    VERBATIM
+  )
+  add_dependencies(libgcrypt generate-files)
+endif()
+
+include(CMakePackageConfigHelpers)
+write_basic_package_version_file(
+  ${CMAKE_CURRENT_BINARY_DIR}/${PROJECT_NAME}-config-version.cmake
+  VERSION ${PROJECT_VERSION}
+  COMPATIBILITY AnyNewerVersion
+)
+
+install(TARGETS ${PROJECT_NAME} EXPORT ${PROJECT_NAME}
+  RUNTIME DESTINATION bin
+  LIBRARY DESTINATION lib
+  ARCHIVE DESTINATION lib
+)
+
+install(FILES ${GEN_DIR}/gcrypt.h DESTINATION include/libgcrypt)
+
+if(MSVC)
+  set_target_properties(${PROJECT_NAME}
+    PROPERTIES
+      COMPILE_PDB_OUTPUT_DIRECTORY ${PROJECT_BINARY_DIR}
+      COMPILE_PDB_NAME ${PROJECT_NAME}
+      COMPILE_PDB_NAME_DEBUG ${PROJECT_NAME}d
+  )
+  install(FILES
+    ${PROJECT_BINARY_DIR}/RelWithDebInfo/libgcrypt.pdb
+    DESTINATION lib
+    CONFIGURATIONS RelWithDebInfo
+  )
+  install(FILES
+    ${PROJECT_BINARY_DIR}/Debug/libgcryptd.pdb
+    DESTINATION lib
+    CONFIGURATIONS Debug
+  )
+endif()
+
+install(EXPORT ${PROJECT_NAME}
+  FILE ${PROJECT_NAME}.cmake
+  NAMESPACE ${PROJECT_NAME}::
+  DESTINATION lib/cmake/${PROJECT_NAME}
+)
+
+install(
+  FILES
+    cmake/${PROJECT_NAME}-config.cmake
+    ${CMAKE_CURRENT_BINARY_DIR}/${PROJECT_NAME}-config-version.cmake
+  DESTINATION lib/cmake/${PROJECT_NAME}
+)
