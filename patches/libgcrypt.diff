diff --git a/cmake/config.h b/cmake/config.h
new file mode 100644
index 0000000..ef70cc0
--- /dev/null
+++ b/cmake/config.h
@@ -0,0 +1,148 @@
+/* config.h for building libgcrypt with MSVC (desktop and UWP).
+ *
+ * Hand written from config.h.in.  MSVC cannot use the GNU assembly
+ * sources or GCC inline assembly, so this is the equivalent of
+ * "configure --disable-asm" for a Windows host: all algorithms use their
+ * portable C implementations and the MPI code uses mpi/generic.  Values
+ * that depend on the target architecture are selected with _WIN64 so the
+ * same file works for Win32, x64 and ARM64.  */
+
+#ifndef _GCRYPT_CONFIG_H_INCLUDED
+#define _GCRYPT_CONFIG_H_INCLUDED
+
+#define PACKAGE "libgcrypt"
+#define PACKAGE_BUGREPORT "https://bugs.gnupg.org"
+#define PACKAGE_NAME "libgcrypt"
+#define PACKAGE_STRING "libgcrypt 1.12.4"
+#define PACKAGE_TARNAME "libgcrypt"
+#define PACKAGE_URL ""
+#define PACKAGE_VERSION "1.12.4"
+#define VERSION "1.12.4"
+
+#define BUILD_COMMITID ""
+#define BUILD_REVISION ""
+#define BUILD_TIMESTAMP "<none>"
+
+/* The default error source for libgcrypt.  */
+#define GPG_ERR_SOURCE_DEFAULT GPG_ERR_SOURCE_GCRYPT
+
+/* No assembler implementations.  */
+#define ASM_DISABLED 1
+
+#define HAVE_W32_SYSTEM 1
+#define HAVE_DOSISH_SYSTEM 1
+#define HAVE_DRIVE_LETTERS 1
+#define PRINTABLE_OS_NAME "W32"
+
+#define SIZEOF_UNSIGNED_SHORT 2
+#define SIZEOF_UNSIGNED_INT 4
+#define SIZEOF_UNSIGNED_LONG 4
+#define SIZEOF_UNSIGNED_LONG_LONG 8
+#define SIZEOF_UINT64_T 8
+#define SIZEOF_UNSIGNED___INT128 0
+#ifdef _WIN64
+#define SIZEOF_VOID_P 8
+#else
+#define SIZEOF_VOID_P 4
+#endif
+#define HAVE_UINTPTR_T 1
+
+/* Windows on x86, x64 and ARM64 is little endian.  */
+#undef WORDS_BIGENDIAN
+
+#define STDC_HEADERS 1
+#define HAVE_INTTYPES_H 1
+#define HAVE_STDINT_H 1
+#define HAVE_STDIO_H 1
+#define HAVE_STDLIB_H 1
+#define HAVE_STRING_H 1
+#define HAVE_SYS_STAT_H 1
+#define HAVE_SYS_TYPES_H 1
+#define HAVE_WCHAR_H 1
+
+#define HAVE_ATEXIT 1
+#define HAVE_MEMMOVE 1
+#define HAVE_RAISE 1
+#define HAVE_RAND 1
+#define HAVE_STRERROR 1
+#define HAVE_STRCASECMP 1  /* mapped to _stricmp below */
+#define HAVE_STRICMP 1
+#define HAVE_STRTOUL 1
+#define HAVE_VPRINTF 1
+
+/* MSVC names for POSIX functions used by libgcrypt.  */
+#ifdef _MSC_VER
+# define strcasecmp  _stricmp
+# define strncasecmp _strnicmp
+# ifndef MS_APP   /* UWP: see cmake/msvc/uwp-compat.h */
+#  define getpid     _getpid
+# endif
+/* MSVC has no ssize_t or pid_t; same definitions as in gcrypt.h.  */
+# include <basetsd.h>
+typedef SSIZE_T ssize_t;
+typedef int pid_t;
+
+/* POSIX file mode macros used for the random seed file.  */
+# define S_IRUSR 0400  /* _S_IREAD */
+# define S_IWUSR 0200  /* _S_IWRITE */
+# define S_ISREG(m) (((m) & _S_IFMT) == _S_IFREG)
+
+/* Thread-local storage (needed by fips.c).  */
+# define HAVE_GCC_STORAGE_CLASS__THREAD 1
+# define __thread __declspec(thread)
+#endif
+
+/* Algorithms: the configure defaults (everything except MD2).  */
+#define LIBGCRYPT_CIPHERS "arcfour:blowfish:cast5:des:aes:twofish:serpent:rfc2268:seed:camellia:idea:salsa20:gost28147:chacha20:sm4:aria"
+#define LIBGCRYPT_PUBKEY_CIPHERS "dsa:elgamal:rsa:ecc:kyber:dilithium"
+#define LIBGCRYPT_DIGESTS "crc:gostr3411-94:md4:md5:rmd160:sha1:sha256:sha512:sha3:tiger:whirlpool:stribog:blake2:sm3"
+#define LIBGCRYPT_KDFS "s2k:pkdf2:scrypt"
+
+#define USE_AES 1
+#define USE_ARCFOUR 1
+#define USE_ARIA 1
+#define USE_BLAKE2 1
+#define USE_BLOWFISH 1
+#define USE_CAMELLIA 1
+#define USE_CAST5 1
+#define USE_CHACHA20 1
+#define USE_CRC 1
+#define USE_DES 1
+#define USE_DILITHIUM 1
+#define USE_DSA 1
+#define USE_ECC 1
+#define USE_ELGAMAL 1
+#define USE_GOST28147 1
+#define USE_GOST_R_3411_12 1
+#define USE_GOST_R_3411_94 1
+#define USE_IDEA 1
+#define USE_KYBER 1
+#define USE_MD4 1
+#define USE_MD5 1
+#define USE_RFC2268 1
+#define USE_RMD160 1
+#define USE_RSA 1
+#define USE_SALSA20 1
+#define USE_SCRYPT 1
+#define USE_SEED 1
+#define USE_SERPENT 1
+#define USE_SHA1 1
+#define USE_SHA256 1
+#define USE_SHA3 1
+#define USE_SHA512 1
+#define USE_SM3 1
+#define USE_SM4 1
+#define USE_TIGER 1
+#define USE_TWOFISH 1
+#define USE_WHIRLPOOL 1
+
+/* Random: the Windows entropy gatherer (rndw32.c).  */
+#define USE_RNDW32 1
+
+#define _GCRYPT_IN_LIBGCRYPT 1
+
+/* We basically use the original Camellia source.  Make sure the symbols
+   properly prefixed.  */
+#define CAMELLIA_EXT_SYM_PREFIX _gcry_
+
+#endif /*_GCRYPT_CONFIG_H_INCLUDED*/
