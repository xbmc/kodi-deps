diff --git a/cmake/msvc/unistd.h b/cmake/msvc/unistd.h
new file mode 100644
index 0000000..5f6baf1
--- /dev/null
+++ b/cmake/msvc/unistd.h
@@ -0,0 +1,39 @@
+/* Minimal unistd.h replacement for building libgcrypt with MSVC.
+ *
+ * The MSVC CRT provides the POSIX functions used by libgcrypt
+ * (read, write, close, lseek, dup, access, isatty, getpid, ...) in
+ * <io.h>, <process.h> and <direct.h>.  */
+
+#ifndef GCRYPT_MSVC_UNISTD_H
+#define GCRYPT_MSVC_UNISTD_H
+
+#include <io.h>
+#include <process.h>
+#include <direct.h>
+#include <stdint.h>
+
+#ifndef R_OK
+# define R_OK 4
+#endif
+#ifndef W_OK
+# define W_OK 2
+#endif
+#ifndef X_OK
+# define X_OK 0
+#endif
+#ifndef F_OK
+# define F_OK 0
+#endif
+
+#ifndef STDIN_FILENO
+# define STDIN_FILENO  0
+#endif
+#ifndef STDOUT_FILENO
+# define STDOUT_FILENO 1
+#endif
+#ifndef STDERR_FILENO
+# define STDERR_FILENO 2
+#endif
+
+
+#endif /*GCRYPT_MSVC_UNISTD_H*/
diff --git a/cmake/msvc/uwp-compat.h b/cmake/msvc/uwp-compat.h
new file mode 100644
index 0000000..05a8823
--- /dev/null
+++ b/cmake/msvc/uwp-compat.h
@@ -0,0 +1,27 @@
+/* Force-included (/FI) into every source file of UWP (WindowsStore) builds.
+ *
+ * libgcrypt calls the generic (ANSI) Windows API names with char
+ * strings, as MinGW builds do.  CMake defines UNICODE for UWP builds, so
+ * undo that before <windows.h> sets up the generic names.  */
+
+#ifndef GCRYPT_UWP_COMPAT_H
+#define GCRYPT_UWP_COMPAT_H
+
+#undef UNICODE
+#undef _UNICODE
+
+#include <winsock2.h>
+#include <windows.h>
+
+/* rpcndr.h defines "small" as char, which clashes with the type of that
+   name in cipher/sntrup761.c.  */
+#undef small
+
+#if !WINAPI_FAMILY_PARTITION(WINAPI_PARTITION_DESKTOP)
+
+/* The UCRT declares getpid() for desktop apps only.  */
+#define getpid() ((int)GetCurrentProcessId ())
+
+#endif /* !WINAPI_PARTITION_DESKTOP */
+
+#endif /*GCRYPT_UWP_COMPAT_H*/
